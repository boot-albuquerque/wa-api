# wa-api — variáveis de ambiente
#
# Copie para `.env` e preencha. O `.env` é carregado por godotenv em
# pkg/bootstrap/main.go:82 e NÃO é versionado; este arquivo é a documentação
# do que existe, sem valor nenhum dentro.

# --- obrigatórias -----------------------------------------------------------
# Token do painel administrativo (/admin/*).
WA_API_ADMIN_TOKEN=

# Chave de cifragem global. AES aceita 16, 24 ou 32 BYTES — conte os bytes,
# não confie no texto da chave: a F67 nasceu de uma chave que dizia
# "De32Caracteres" e tinha 34.
WA_API_GLOBAL_ENCRYPTION_KEY=

# Chave HMAC global, usada para assinar os webhooks.
WA_API_GLOBAL_HMAC_KEY=

# --- servidor ---------------------------------------------------------------
WA_API_ADDRESS=0.0.0.0
WA_API_PORT=8080
WA_API_LOG_LEVEL=info
TZ=America/Sao_Paulo

# --- banco ------------------------------------------------------------------
# Sem TODAS as cinco, o projeto cai para SQLite (e avisa em warn).
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
DB_SSLMODE=disable

# --- webhook ----------------------------------------------------------------
WA_API_GLOBAL_WEBHOOK=
WA_API_WEBHOOK_USE_PROXY=false
WEBHOOK_FORMAT=
WEBHOOK_RETRY_ENABLED=true
WEBHOOK_RETRY_COUNT=5
WEBHOOK_RETRY_DELAY_SECONDS=30

# --- RabbitMQ (opcional) ----------------------------------------------------
# Sem RABBITMQ_URL a publicação é desligada.
RABBITMQ_URL=
RABBITMQ_QUEUE=
WEBHOOK_ERROR_QUEUE_NAME=

# --- identificação da sessão ------------------------------------------------
SESSION_DEVICE_NAME=
SESSION_PLATFORM_TYPE=

# --- resiliência de entrega (F86) ------------------------------------------
# Teto de goroutines simultâneas no despacho de eventos. Cada evento pode
# disparar até 4 entregas (webhook do usuário, WebSocket, webhook global,
# RabbitMQ), e sem teto uma rajada de HistorySync as multiplica sem limite.
#
# PADRÃO 0 (desligado), por decisão deliberada: a aquisição bloqueia o
# chamador, que em produção é o handler de eventos do SDK. Com o teto
# saturado, um webhook lento atrasaria o processamento de TODOS os eventos da
# sessão. Trocar "goroutines demais" por "handler parado" pode ser pior, e
# ainda não foi medido — ver F86.
#
# Valores medidos numa rajada de 800 entregas com HTTP real (3 rodadas):
#   sem teto  ~4.000 goroutines,  ~32MB de heap,   207ms
#   teto=64     ~350 goroutines,  ~13MB de heap,  1.310ms
WA_API_DISPATCH_MAX_CONCURRENCY=0
