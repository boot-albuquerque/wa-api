# wa-api — variáveis de ambiente
#
# Copie para `.env` e preencha. O `.env` é carregado por godotenv em
# pkg/bootstrap/main.go:82 e NÃO é versionado; este arquivo é a documentação
# do que existe, sem valor nenhum dentro.

# --- obrigatórias -----------------------------------------------------------
# Token do painel administrativo (/admin/*).
WA_API_ADMIN_TOKEN=

# Chave de cifragem global. AES aceita 16, 24 ou 32 BYTES — conte os bytes,
# não confie no texto da chave: a F67 nasceu de uma chave que dizia
# "De32Caracteres" e tinha 34.
WA_API_GLOBAL_ENCRYPTION_KEY=

# Chave HMAC global, usada para assinar os webhooks.
WA_API_GLOBAL_HMAC_KEY=

# --- servidor ---------------------------------------------------------------
WA_API_ADDRESS=0.0.0.0
WA_API_PORT=8080
WA_API_LOG_LEVEL=info
TZ=America/Sao_Paulo

# --- banco ------------------------------------------------------------------
# Sem TODAS as cinco, o projeto cai para SQLite (e avisa em warn).
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
DB_SSLMODE=disable

# --- webhook ----------------------------------------------------------------
WA_API_GLOBAL_WEBHOOK=
WA_API_WEBHOOK_USE_PROXY=false
WEBHOOK_FORMAT=
WEBHOOK_RETRY_ENABLED=true
WEBHOOK_RETRY_COUNT=5
WEBHOOK_RETRY_DELAY_SECONDS=30

# --- RabbitMQ (opcional) ----------------------------------------------------
# Sem RABBITMQ_URL a publicação é desligada.
RABBITMQ_URL=
RABBITMQ_QUEUE=
WEBHOOK_ERROR_QUEUE_NAME=

# --- identificação da sessão ------------------------------------------------
SESSION_DEVICE_NAME=
SESSION_PLATFORM_TYPE=

# --- resiliência de entrega (F86) ------------------------------------------
# Cada evento pode disparar até 4 entregas (WebSocket, webhook do usuário,
# webhook global, RabbitMQ), e cada uma faz E/S de rede. Antes disto cada
# entrega era uma goroutine solta, sem teto.
#
# O desenho é uma ESCADA de degradação, e em nenhum degrau se descarta entrega:
#
#   rajada <= pool       indistinguível de não ter mecanismo
#   rajada  > pool       enfileira: entrega mais lenta, COMPLETA
#   rajada  > orçamento  o handler absorve backpressure, ainda SEM PERDA
#
# Não há detector de rajada: a escada já degrada sozinha, e um detector seria
# limiar para calibrar, histerese para acertar e oscilação para depurar.

# Tamanho do pool de entrega. ZERO DESLIGA o mecanismo e restaura o
# comportamento anterior à F86 — é o rollback, e é distinto de valor inválido
# (que cai no padrão, com aviso em Warn).
#
# O padrão 256 vem da rajada medida em produção: o pico de PAREAMENTO foi de
# 23 eventos em 100ms, que são 92 entregas. Com 256, esse pico passa direto
# sem enfileirar nada, e o mecanismo só aparece a partir de ~3 pareamentos
# simultâneos. O estado estacionário desta instalação (0,03 evento/s) nunca
# encosta nele.
#
# Medido com 8.000 entregas e HTTP real (mediana de 3 rodadas), pool variando:
#   sem pool   ~14.393 goroutines, ~124MB de heap, dreno degradou 0,5s->10,9s
#   64w           ~344 goroutines,  ~69MB de heap, dreno 12,6s
#   256w        ~1.382 goroutines,  ~36MB de heap, dreno  3,2s
#   512w        ~2.967 goroutines,  ~51MB de heap, dreno  1,7s
WA_API_DISPATCH_WORKERS=256

# Orçamento da fila de despacho, em BYTES.
#
# A unidade é byte e não item de propósito: os payloads medidos nesta
# instalação vão de 1,5KB a 120KB — o máximo é 40× a mediana, então uma fila
# de N itens teria teto de memória 40× diferente conforme a sorte do lote.
#
# O padrão 32MB vem da marca d'água medida: uma rajada de 8.000 entregas
# (~87 pareamentos simultâneos) segurou 26,8MB de pico. Até essa escala o
# handler de eventos não é tocado.
#
# A troca é uma RETA, sem joelho — ~1,4MB de heap compra ~110ms a menos de
# handler travado, até o orçamento cobrir a rajada, depois não compra mais
# nada. Medido com 8.000 entregas e pool de 256:
#   1MB   handler 3,131s   heap 27,1MB
#   8MB   handler 2,329s   heap 41,3MB
#   16MB  handler 1,514s   heap 57,8MB
#   32MB  handler   407ms  heap 69,5MB   (= sem mecanismo nenhum)
#
# O dreno é CONSTANTE (~3,2s) em todos eles: o orçamento não afeta vazão de
# entrega, só decide quem espera.
WA_API_DISPATCH_QUEUE_BYTES=33554432
