# .env
# Server Configuration
WA_API_PORT=8080
WA_API_ADDRESS=0.0.0.0

# Token for WuzAPI Admin
WA_API_ADMIN_TOKEN=1234ABCD

# Encryption key for sensitive data (32 bytes for AES-256)
WA_API_GLOBAL_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Global HMAC Key for webhook signing (minimum 32 characters)
WA_API_GLOBAL_HMAC_KEY=your_global_hmac_key_here_minimum_32_chars

# Global webhook URL
WA_API_GLOBAL_WEBHOOK=https://example.com/webhook

# Breaking change: outgoing webhook deliveries now verify TLS certificates by
# default (previously verification was always disabled). If your webhook
# receiver uses a self-signed certificate, set this to "true" to restore the
# old behavior — a WARN is logged once at boot when enabled. Default: false.
WA_API_WEBHOOK_TLS_SKIP_VERIFY=false

# "json" or "form" for the default
WEBHOOK_FORMAT=json

# Route webhook deliveries through the per-user proxy when configured (default: true)
WA_API_WEBHOOK_USE_PROXY=true

# WuzAPI Session Configuration
SESSION_DEVICE_NAME=WuzAPI

# Database configuration
DB_USER=wa-api
DB_PASSWORD=wa-api
DB_NAME=wa-api
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=false
TZ=America/Sao_Paulo

# RabbitMQ configuration Optional
RABBITMQ_URL=amqp://wa-api:wa-api@localhost:5672/%2F
RABBITMQ_QUEUE=whatsapp_events
