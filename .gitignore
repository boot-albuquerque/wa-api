# --- Go ---
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/wuzapi
/bin/
/dist/
/build/

# Test binary, built with `go test -c`
*.test

# Output of `go coverage`
*.out
coverage.out
coverage.html

# Go workspace
go.work
go.work.sum

# --- Dependencies ---
node_modules/
vendor/

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
credentials.*
*_credentials.*
.service_account.json

# --- OS ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.Trash-*

